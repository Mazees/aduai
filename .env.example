# Supabase Credentials (Wajib diisi sesuai proyek Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Penyedia AI (Groq / OpenAI / Custom Provider)
AI_PROVIDER_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
AI_PROVIDER_MODEL=llama-3.3-70b-versatile
AI_PROVIDER_API_KEY=your-ai-provider-api-key

# Penyedia WhatsApp (Fonnte / Wablas / Custom Gateway)
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_API_URL=https://api.whatsapp.provider.com/send
